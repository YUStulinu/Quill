{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quill",
  "scopeName": "source.quill",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.quill", "match": "//.*$" },
        { "name": "comment.block.quill", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.quill",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.quill", "match": "\\\\[ntr0\\\\\"]" }]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.function.quill" }, "2": { "name": "entity.name.function.quill" } }
        },
        {
          "match": "\\b(type)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.type.quill" }, "2": { "name": "entity.name.type.quill" } }
        },
        {
          "match": "\\b(let|var)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.quill" }, "2": { "name": "variable.other.declaration.quill" } }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.quill", "match": "\\b(if|else|while|match|return)\\b" },
        { "name": "keyword.declaration.quill", "match": "\\b(fn|let|var|type)\\b" },
        { "name": "constant.language.boolean.quill", "match": "\\b(true|false)\\b" }
      ]
    },
    "numbers": {
      "name": "constant.numeric.integer.quill",
      "match": "\\b[0-9][0-9_]*\\b"
    },
    "builtins": {
      "name": "support.function.builtin.quill",
      "match": "\\b(print|println|print_int|int_to_string|string_length|string_get|substring|char_to_string|string_to_int|array_make|array_get|array_set|array_length|panic|assert|clock_ms|gc_collect|gc_count)\\b(?=\\s*\\()"
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.quill", "match": "\\b(Int|Bool|String|Array|Unit)\\b" },
        { "name": "entity.name.type.quill", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.quill" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.quill", "match": "->|=>" },
        { "name": "keyword.operator.quill", "match": "\\+\\+|==|!=|<=|>=|&&|\\|\\||[-+*/%<>=!|]" }
      ]
    }
  }
}
